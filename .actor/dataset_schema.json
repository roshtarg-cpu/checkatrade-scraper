{
  "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
  "actorSpecification": 1,
  "fields": {
    "url": {
      "type": "string",
      "title": "Profile URL"
    },
    "name": {
      "type": "string",
      "title": "Business Name"
    },
    "phone": {
      "type": "string",
      "title": "Phone Number"
    },
    "trade": {
      "type": "string",
      "title": "Trade"
    },
    "rating": {
      "type": "string",
      "title": "Rating"
    },
    "reviewCount": {
      "type": "integer",
      "title": "Review Count"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "services": {
      "type": "string",
      "title": "Services"
    },
    "verified": {
      "type": "boolean",
      "title": "Verified"
    },
    "scrapedAt": {
      "type": "string",
      "title": "Scraped At"
    }
  },
  "views": {
    "overview": {
      "title": "Overview",
      "transformation": {
        "fields": ["name", "trade", "rating", "location"]
      },
      "display": {
        "component": "table",
        "properties": {
          "name": {
            "label": "Business Name",
            "format": "text"
          },
          "trade": {
            "label": "Trade",
            "format": "text"
          },
          "rating": {
            "label": "Rating",
            "format": "text"
          },
          "location": {
            "label": "Location",
            "format": "text"
          }
        }
      }
    }
  }
}
